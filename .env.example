# Copy to .env and replace every replace_me value before first boot.
#   cp .env.example .env
#   openssl rand -hex 24   # use a fresh value per secret
#
# Production host .env lives on the droplet only. Do not commit it.
# UI is Windshift at https://pm.newmarketsecurity.com (one host, no tickets subdomain).
# This stack is the Lockhaven HMAC ingest sidecar only.

PRODUCT_NAME=Tickets
PUBLIC_HOST=pm.newmarketsecurity.com
PUBLIC_URL=https://pm.newmarketsecurity.com
INGEST_PORT=4000
TZ=UTC

# --- SSO lives on the Windshift instance (client pm), not here. ---
OIDC_ISSUER=https://auth.newmarketsecurity.com/realms/nms
OIDC_CLIENT_ID=pm

# --- Lockhaven signed ingest (same HMAC as Console webhook channels) ---
INGEST_HMAC_SECRET=replace_me
WINDSHIFT_URL=http://windshift:8080
# Mint in Windshift (API token with items:read items:write mcp:access). Host only.
WINDSHIFT_API_TOKEN=replace_me
WINDSHIFT_WORKSPACE=replace_me

# Public host the existing edge proxy (Caddy or Traefik) should serve.
# Do not start a second Caddy and do not bind 80/443 from this compose file.
EDGE_NETWORK=proxy
