# Copy to .env and replace every replace_me value before first boot.
#   cp .env.example .env
#   openssl rand -hex 24   # use a fresh value per secret
#
# Production host .env lives on the droplet only. Do not commit it.

# --- Postgres (not published to the host network) ---
POSTGRES_DB=desk
POSTGRES_USER=desk
POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgres://desk:replace_me@postgres:5432/desk

# --- App ---
PORT=4000
PRODUCT_NAME=Tickets
PUBLIC_HOST=tickets.newmarketsecurity.com
PUBLIC_URL=http://localhost:4000
# Behind the edge proxy, set PUBLIC_URL=https://tickets.newmarketsecurity.com
SESSION_SECRET=replace_me

# --- SSO (Keycloak realm nms) ---
OIDC_ISSUER=https://auth.newmarketsecurity.com/realms/nms
OIDC_CLIENT_ID=tickets
OIDC_CLIENT_SECRET=replace_me
OIDC_SCOPES=openid profile email

# --- Lockhaven signed ingest (same HMAC as Console webhook channels) ---
INGEST_HMAC_SECRET=replace_me

# Public host the existing edge proxy (Caddy or Traefik) should serve.
# Do not start a second Caddy and do not bind 80/443 from this compose file.
EDGE_NETWORK=proxy
